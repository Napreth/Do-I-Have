<resources>
    <style name="BaseAppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#292929</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#F6F6F6</item>
    </style>
    <style name="BaseAppTheme.Dark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#E0E0E0</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#111111</item>
    </style>
    <style name="AppTheme" parent="BaseAppTheme" />
    <style name="AppTheme.Dark" parent="BaseAppTheme.Dark" />
</resources>
